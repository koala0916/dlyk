<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjpowernode.mapper.TClueMapper">

  <resultMap id="BaseResultMap" type="com.bjpowernode.entity.TClue">
    <id column="id" property="id" />
    <result column="name" property="name" />
    <result column="age" property="age" />
    <result column="phone" property="phone" />
    <result column="intention_course" property="intentionCourse" />
    <result column="intention_strength" property="intentionStrength" />
    <result column="source" property="source" />
    <result column="remark" property="remark" />
    <result column="trial_class_time" property="trialClassTime" />
    <result column="clue_status" property="clueStatus" />
    <result column="create_by" property="createBy" />
    <result column="create_time" property="createTime" />
  </resultMap>

  <resultMap id="DetailResultMap" type="com.bjpowernode.entity.TClue" extends="BaseResultMap">
    <association property="createByDO" javaType="com.bjpowernode.entity.TUser">
      <id column="createByUserId" property="id" />
      <result column="createByUserName" property="name" />
    </association>
  </resultMap>

  <sql id="Base_Column_List">
    id, name, age, phone, intention_course, intention_strength, source, remark,
    trial_class_time, clue_status, create_by, create_time
  </sql>

  <select id="selectByPrimaryKey" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" /> from t_clue where id = #{id}
  </select>

  <select id="selectDetailById" resultMap="DetailResultMap">
    select tc.*, u.id createByUserId, u.name createByUserName
    from t_clue tc left join t_user u on tc.create_by = u.id
    where tc.id = #{id}
  </select>

  <select id="selectByPage" resultMap="DetailResultMap">
    select tc.*, u.id createByUserId, u.name createByUserName
    from t_clue tc left join t_user u on tc.create_by = u.id
    <where>
      ${filterSQL}
    </where>
    order by (tc.clue_status = '已转客户') asc,
             tc.intention_strength is null, tc.intention_strength desc,
             tc.trial_class_time is null, tc.trial_class_time asc,
             tc.id desc
  </select>

  <select id="selectByPageForExport" resultMap="DetailResultMap">
    select tc.*, u.id createByUserId, u.name createByUserName
    from t_clue tc left join t_user u on tc.create_by = u.id
    <where>
      <if test="idList != null and idList.size() > 0">
        and tc.id in
        <foreach collection="idList" item="id" open="(" separator="," close=")">#{id}</foreach>
      </if>
      ${filterSQL}
    </where>
    order by (tc.clue_status = '已转客户') asc, tc.intention_strength desc, tc.id desc
  </select>

  <select id="selectTotalClueCount" resultType="java.lang.Integer">
    select count(1) from t_clue
  </select>

  <select id="selectClueSourceCount" resultType="com.bjpowernode.vo.NameValueData">
    select ifnull(source, '未知') name, count(1) value
    from t_clue
    group by source
  </select>

  <delete id="deleteByPrimaryKey">
    delete from t_clue where id = #{id}
  </delete>

  <insert id="insertSelective" keyColumn="id" keyProperty="id" useGeneratedKeys="true" parameterType="com.bjpowernode.entity.TClue">
    insert into t_clue
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="name != null">name,</if>
      <if test="age != null">age,</if>
      <if test="phone != null">phone,</if>
      <if test="intentionCourse != null">intention_course,</if>
      <if test="intentionStrength != null">intention_strength,</if>
      <if test="source != null">source,</if>
      <if test="remark != null">remark,</if>
      <if test="trialClassTime != null">trial_class_time,</if>
      <if test="clueStatus != null">clue_status,</if>
      <if test="createBy != null">create_by,</if>
      <if test="createTime != null">create_time,</if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      <if test="name != null">#{name},</if>
      <if test="age != null">#{age},</if>
      <if test="phone != null">#{phone},</if>
      <if test="intentionCourse != null">#{intentionCourse},</if>
      <if test="intentionStrength != null">#{intentionStrength},</if>
      <if test="source != null">#{source},</if>
      <if test="remark != null">#{remark},</if>
      <if test="trialClassTime != null">#{trialClassTime},</if>
      <if test="clueStatus != null">#{clueStatus},</if>
      <if test="createBy != null">#{createBy},</if>
      <if test="createTime != null">#{createTime},</if>
    </trim>
  </insert>

  <update id="updateByPrimaryKeySelective" parameterType="com.bjpowernode.entity.TClue">
    update t_clue
    <set>
      <if test="name != null">name = #{name},</if>
      <if test="age != null">age = #{age},</if>
      <if test="phone != null">phone = #{phone},</if>
      <if test="intentionCourse != null">intention_course = #{intentionCourse},</if>
      <if test="intentionStrength != null">intention_strength = #{intentionStrength},</if>
      <if test="source != null">source = #{source},</if>
      <if test="remark != null">remark = #{remark},</if>
      <if test="trialClassTime != null">trial_class_time = #{trialClassTime},</if>
      <if test="clueStatus != null">clue_status = #{clueStatus},</if>
    </set>
    where id = #{id}
  </update>
</mapper>
