<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjpowernode.mapper.TCustomerMapper">

  <resultMap id="BaseResultMap" type="com.bjpowernode.entity.TCustomer">
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="name" jdbcType="VARCHAR" property="name" />
    <result column="phone" jdbcType="VARCHAR" property="phone" />
    <result column="age" jdbcType="INTEGER" property="age" />
    <result column="course_type" jdbcType="VARCHAR" property="courseType" />
    <result column="remaining_lessons" jdbcType="INTEGER" property="remainingLessons" />
    <result column="course_expire_time" jdbcType="TIMESTAMP" property="courseExpireTime" />
    <result column="remark" jdbcType="LONGVARCHAR" property="remark" />
    <result column="create_by" jdbcType="INTEGER" property="createBy" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
    <result column="source" jdbcType="VARCHAR" property="source" />
    <result column="studying" jdbcType="INTEGER" property="studying" />
    <result column="clue_id" jdbcType="INTEGER" property="clueId" />
  </resultMap>

  <resultMap id="DetailResultMap" type="com.bjpowernode.entity.TCustomer" extends="BaseResultMap">
    <association property="createByDO" javaType="com.bjpowernode.entity.TUser">
      <id column="createByUserId" jdbcType="INTEGER" property="id" />
      <result column="createByUserName" jdbcType="VARCHAR" property="name" />
    </association>
  </resultMap>

  <sql id="Base_Column_List">
    id, name, phone, age, course_type, remaining_lessons, course_expire_time, remark,
    create_by, create_time, source, studying, clue_id
  </sql>

  <select id="selectByPrimaryKey" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" /> from t_customer where id = #{id}
  </select>

  <select id="selectDetailById" resultMap="DetailResultMap">
    select
      tc.*,
      u.id createByUserId,
      u.name createByUserName
    from t_customer tc
      left join t_user u on tc.create_by = u.id
    where tc.id = #{id}
  </select>

  <select id="selectByPage" resultMap="DetailResultMap">
    select
      tc.*,
      u.id createByUserId,
      u.name createByUserName
    from t_customer tc
      left join t_user u on tc.create_by = u.id
    <where>
      <if test="idList != null and idList.size() > 0">
        and tc.id in
        <foreach collection="idList" item="id" open="(" separator="," close=")">
          #{id}
        </foreach>
      </if>
    </where>
    order by tc.studying desc,
             tc.remaining_lessons is null, tc.remaining_lessons asc,
             tc.course_expire_time is null, tc.course_expire_time asc,
             tc.id asc
  </select>

  <select id="selectTotalCustomerCount" resultType="java.lang.Integer">
    select count(1) from t_customer
  </select>

  <delete id="deleteByPrimaryKey">
    delete from t_customer where id = #{id}
  </delete>

  <insert id="insert" keyColumn="id" keyProperty="id" useGeneratedKeys="true" parameterType="com.bjpowernode.entity.TCustomer">
    insert into t_customer (name, phone, age, course_type, remaining_lessons, course_expire_time,
      remark, create_by, create_time, source, studying, clue_id)
    values (#{name}, #{phone}, #{age}, #{courseType}, #{remainingLessons}, #{courseExpireTime},
      #{remark}, #{createBy}, #{createTime}, #{source}, #{studying}, #{clueId})
  </insert>

  <insert id="insertSelective" keyColumn="id" keyProperty="id" useGeneratedKeys="true" parameterType="com.bjpowernode.entity.TCustomer">
    insert into t_customer
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="name != null">name,</if>
      <if test="phone != null">phone,</if>
      <if test="age != null">age,</if>
      <if test="courseType != null">course_type,</if>
      <if test="remainingLessons != null">remaining_lessons,</if>
      <if test="courseExpireTime != null">course_expire_time,</if>
      <if test="remark != null">remark,</if>
      <if test="createBy != null">create_by,</if>
      <if test="createTime != null">create_time,</if>
      <if test="source != null">source,</if>
      <if test="studying != null">studying,</if>
      <if test="clueId != null">clue_id,</if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      <if test="name != null">#{name},</if>
      <if test="phone != null">#{phone},</if>
      <if test="age != null">#{age},</if>
      <if test="courseType != null">#{courseType},</if>
      <if test="remainingLessons != null">#{remainingLessons},</if>
      <if test="courseExpireTime != null">#{courseExpireTime},</if>
      <if test="remark != null">#{remark},</if>
      <if test="createBy != null">#{createBy},</if>
      <if test="createTime != null">#{createTime},</if>
      <if test="source != null">#{source},</if>
      <if test="studying != null">#{studying},</if>
      <if test="clueId != null">#{clueId},</if>
    </trim>
  </insert>

  <update id="updateByPrimaryKeySelective" parameterType="com.bjpowernode.entity.TCustomer">
    update t_customer
    <set>
      <if test="name != null">name = #{name},</if>
      <if test="phone != null">phone = #{phone},</if>
      <if test="age != null">age = #{age},</if>
      <if test="courseType != null">course_type = #{courseType},</if>
      <if test="remainingLessons != null">remaining_lessons = #{remainingLessons},</if>
      <if test="courseExpireTime != null">course_expire_time = #{courseExpireTime},</if>
      <if test="remark != null">remark = #{remark},</if>
      <if test="source != null">source = #{source},</if>
      <if test="studying != null">studying = #{studying},</if>
      <if test="clueId != null">clue_id = #{clueId},</if>
    </set>
    where id = #{id}
  </update>
</mapper>
