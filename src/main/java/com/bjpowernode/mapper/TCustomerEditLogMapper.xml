<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjpowernode.mapper.TCustomerEditLogMapper">

  <resultMap id="BaseResultMap" type="com.bjpowernode.entity.TCustomerEditLog">
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="customer_id" jdbcType="INTEGER" property="customerId" />
    <result column="edit_by" jdbcType="INTEGER" property="editBy" />
    <result column="edit_time" jdbcType="TIMESTAMP" property="editTime" />
    <result column="change_content" jdbcType="VARCHAR" property="changeContent" />
    <association property="editByDO" javaType="com.bjpowernode.entity.TUser">
      <id column="editByUserId" jdbcType="INTEGER" property="id" />
      <result column="editByUserName" jdbcType="VARCHAR" property="name" />
    </association>
  </resultMap>

  <insert id="insert" keyColumn="id" keyProperty="id" useGeneratedKeys="true"
    parameterType="com.bjpowernode.entity.TCustomerEditLog">
    insert into t_customer_edit_log (customer_id, edit_by, edit_time, change_content)
    values (#{customerId}, #{editBy}, #{editTime}, #{changeContent})
  </insert>

  <delete id="deleteByCustomerId">
    delete from t_customer_edit_log where customer_id = #{customerId}
  </delete>

  <select id="selectByCustomerId" resultMap="BaseResultMap">
    select
      l.id, l.customer_id, l.edit_by, l.edit_time, l.change_content,
      u.id editByUserId,
      u.name editByUserName
    from t_customer_edit_log l
      left join t_user u on l.edit_by = u.id
    where l.customer_id = #{customerId}
    order by l.edit_time desc, l.id desc
  </select>
</mapper>
