    <select id="selectByPage" resultMap="CustomerResultMap">
      SELECT
        cu.*,
        tu.id ownerId,
        tu.`name` ownerName,
        ta.id activityId,
        ta.`name` activityName,
        tc.id clueId,
        tc.full_name customerName,
        tdv1.id appellationId,
        tdv1.type_value appellationName,
        tc.phone phone,
        tc.weixin weixin,
        tdv2.id loanId,
        tdv2.type_value loanName,
        tdv3.id intentionStateId,
        tdv3.type_value intentionStateName,
        tdv4.id stateId,
        tdv4.type_value stateName,
        tdv5.id sourceId,
        tdv5.type_value sourceName,
        tp.id productId,
        tp.name productName

      FROM
        `t_customer` cu
          LEFT JOIN t_clue tc ON cu.clue_id = tc.id
          LEFT JOIN t_user tu ON tc.owner_id=tu.id
          LEFT JOIN t_activity ta ON tc.activity_id=ta.id
          LEFT JOIN t_dic_value tdv1 ON tc.appellation=tdv1.id
          LEFT JOIN t_dic_value tdv2 ON tc.need_loan=tdv2.id
          LEFT JOIN t_dic_value tdv3 ON tc.intention_state=tdv3.id
          LEFT JOIN t_dic_value tdv4 ON tc.state=tdv4.id
          LEFT JOIN t_dic_value tdv5 ON tc.source=tdv5.id
          LEFT JOIN t_product tp ON tp.id=cu.product
      <where>

        <if test="idList != null">
          and cu.id in
          <foreach collection="idList" item="id" open="(" separator="," close=")">
            #{id}
          </foreach>
        </if>

        <if test="baseQuery.filterSQL != null ">
          ${baseQuery.filterSQL}
        </if>
      </where>
    </select>

  <select id="selectById" resultMap="CustomerResultMap">
    SELECT
      tc.*,
      tp.id productId,
      tp.name productName,
      tu1.id createById,
      tu1.name createByName,
      tu2.id editById,
      tu2.name editByName
    FROM
      t_customer tc
        JOIN t_product tp ON tc.product = tp.id
        LEFT JOIN t_user tu1 ON tc.create_by=tu1.id
        LEFT JOIN t_user tu2 ON tc.edit_by=tu2.id

    WHERE tc.id=#{id}
  </select>
